# Repository-wide ignores.
# backend/.gitignore (Gradle) and frontend/.gitignore (Node) stay in place as well
# and cover their subdirectories.

# --- Secrets -----------------------------------------------------------------
.env
.env.local
.env.bak
.env.*.bak
.env.*.local
*.pem
*.key
!.env.example

# --- Build output ------------------------------------------------------------
build/
dist/
out/
bin/
node_modules/
.gradle/

# --- Python (tools/) ---------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- IDE / Editor ------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
*.swp
*~

# --- Operating system --------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Logs / temporary files ---------------------------------------------------
*.log
logs/
tmp/
*.pid
/session-1.md

# --- Data (models, agents, tasks, Postgres cluster) --------------------------
data/
