# Copy to .env and adjust.

# Provider used without explicit selection: openai | local | qwen
AI_DEFAULT_PROVIDER=openai

# --- Cloud -------------------------------------------------------------------
# Works with OpenAI itself and any OpenAI-compatible gateway
# (OpenRouter, Azure gateway, LiteLLM, Groq, ...). base-url ALWAYS incl. /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Local -------------------------------------------------------------------
# Any OpenAI-compatible server. From inside the container the host must be
# addressed as host.docker.internal, not as localhost.
#   LM Studio   http://host.docker.internal:1234/v1
#   Ollama      http://host.docker.internal:11434/v1
#   vLLM        http://host.docker.internal:8000/v1
#   llama.cpp   http://host.docker.internal:8080/v1
LOCAL_AI_BASE_URL=http://host.docker.internal:1234/v1
LOCAL_AI_API_KEY=not-needed
LOCAL_AI_MODEL=local-model
LOCAL_AI_ENABLED=true

# --- Gateway (LiteLLM & Co.) -------------------------------------------------
# A gateway serves several models behind one URL. Each model gets its own provider
# id, because a provider is endpoint AND model — only that pair is comparable in an
# experiment. URL and key are shared, base-url ALWAYS incl. /v1.
# Empty base-url = provider counts as not configured and stays out of the way.
#LITELLM_BASE_URL=https://litellm.example.com/v1
#LITELLM_API_KEY=sk-...
#QWEN_MODEL=Qwen/Qwen3.6-27B-FP8
#LITELLM_ENABLED=true

# --- SOUL --------------------------------------------------------------------
# The co-worker's identity. The default SOULs ship in the jar under classpath:souls/.
# An additional location is read afterwards and wins for the same id — so a SOUL is
# replaceable without rebuilding the image (mount the directory in docker-compose).
#   SOUL_LOCATIONS=classpath:souls/,file:/souls/
SOUL_LOCATIONS=classpath:souls/
SOUL_ACTIVE=forge

# --- Database (runs, traces, scores) -----------------------------------------
# Postgres with pgvector. Host port 5433 because developer machines often already
# run a Postgres on 5432; inside the compose network the backend talks to postgres:5432.
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_PORT=5433

# --- Tasks -------------------------------------------------------------------
# Reusable, versioned goals. As with SOULs an additional location wins for the
# same id: TASK_LOCATIONS=classpath:tasks/,file:/tasks/
TASK_LOCATIONS=classpath:tasks/

# --- Strategy profiles -------------------------------------------------------
# Which continual-learning strategies are active. baseline = none. As with SOULs an
# additional location wins for the same id: PROFILE_LOCATIONS=classpath:profiles/,file:/profiles/
PROFILE_LOCATIONS=classpath:profiles/
PROFILE_DEFAULT=baseline

# Agenten: Modell + SOUL + Werkzeug-Positivliste als versionierte Markdown-Entitaet.
# Spaetere Location gewinnt bei gleicher Id.
#AGENT_LOCATIONS=classpath:agents/,file:/agents/
#AGENT_DEFAULT=forge
# Obergrenze fuer die Trainings eines Experiments (laufen nacheinander).
#AGENT_MAX_EXPERIMENT_TRAININGS=6

# --- Agent budget ------------------------------------------------------------
# An agent with tools can loop forever. These limits are mandatory, not a convenience.
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_CALLS_PER_TOOL=8
AGENT_MAX_DURATION_MS=180000
# Global cap on rejections per strategy in the beforeFinish loop.
AGENT_MAX_VERIFY_ROUNDS=3
# Upper bound for runs in one training — a typo must not schedule a thousand model calls.
AGENT_MAX_TRAINING_REPETITIONS=50

# --- Tools -------------------------------------------------------------------
TOOLS_BUILTIN_ENABLED=true
# Fixed instant for the time tool (ISO-8601), e.g. 2026-09-17T10:00:00Z. Empty = wall clock.
# Set it for reproducible runs against mocks.
TOOLS_FIXED_TIME=
# Example MCP server against tools/mock-mcp-server.py. Real servers are registered
# as app.tools.mcp.<id>.* in application.properties.
MCP_MOCK_ENABLED=false
MCP_MOCK_URL=http://host.docker.internal:3333/mcp
