# Kopieren nach .env und anpassen.

# Welcher Provider wird ohne explizite Auswahl genutzt: openai | local
AI_DEFAULT_PROVIDER=openai

# --- Cloud -------------------------------------------------------------------
# Funktioniert mit OpenAI selbst und jedem OpenAI-kompatiblen Gateway
# (OpenRouter, Azure-Gateway, LiteLLM, Groq, ...). base-url IMMER inkl. /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Lokal -------------------------------------------------------------------
# Beliebiger OpenAI-kompatibler Server. Aus dem Container heraus muss der Host
# als host.docker.internal adressiert werden, nicht als localhost.
#   LM Studio   http://host.docker.internal:1234/v1
#   Ollama      http://host.docker.internal:11434/v1
#   vLLM        http://host.docker.internal:8000/v1
#   llama.cpp   http://host.docker.internal:8080/v1
LOCAL_AI_BASE_URL=http://host.docker.internal:1234/v1
LOCAL_AI_API_KEY=not-needed
LOCAL_AI_MODEL=local-model
LOCAL_AI_ENABLED=true

# --- SOUL --------------------------------------------------------------------
# Identitaet des Mitarbeiters. Die Standard-SOULs liegen im Jar unter classpath:souls/.
# Eine zusaetzliche Location wird danach gelesen und gewinnt bei gleicher Id — damit ist
# eine SOUL austauschbar, ohne das Image neu zu bauen (Verzeichnis in docker-compose mounten).
#   SOUL_LOCATIONS=classpath:souls/,file:/souls/
SOUL_LOCATIONS=classpath:souls/
SOUL_ACTIVE=forge

# --- Datenbank (Runs + Traces) -----------------------------------------------
# Postgres mit pgvector. Host-Port 5433, weil auf Entwicklerrechnern haeufig schon
# ein Postgres auf 5432 laeuft; im Compose-Netz spricht das Backend postgres:5432.
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_PORT=5433

# --- Agent-Budget ------------------------------------------------------------
# Ein Agent mit Tools kann im Kreis laufen. Diese Grenzen sind Pflicht, nicht Komfort.
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_CALLS_PER_TOOL=8
AGENT_MAX_DURATION_MS=180000

# --- Werkzeuge ---------------------------------------------------------------
TOOLS_BUILTIN_ENABLED=true
# Beispiel-MCP-Server gegen tools/mock-mcp-server.py. Echte Server werden als
# app.tools.mcp.<id>.* in application.properties eingetragen.
MCP_MOCK_ENABLED=false
MCP_MOCK_URL=http://host.docker.internal:3333/mcp
