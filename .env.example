# Copy to .env and adjust. Everything here reaches the backend container (env_file).

# --- Data --------------------------------------------------------------------
# One directory on this machine for everything that is not code:
#   DATA_DIR/files/<kind>/<id>/v<n>.md   models, agents, tasks — written by the UI
#   DATA_DIR/db                          the Postgres cluster
# Relative paths are resolved from the compose file's directory.
DATA_DIR=./data

# --- API keys ----------------------------------------------------------------
# A model file never holds a key, only the NAME of a variable. The UI offers every variable
# that starts with API_KEY_ (names only, values stay here). One per provider is enough —
# several models on the same gateway share it.
#API_KEY_OPENAI=sk-...
#API_KEY_LITELLM=sk-...

# --- Database ----------------------------------------------------------------
POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
# Host port; inside the compose network the backend talks to postgres:5432.
POSTGRES_PORT=5433

# --- Run budget --------------------------------------------------------------
# An agent with tools can loop forever. These limits are mandatory, not a convenience.
RUN_MAX_TOOL_CALLS=20
RUN_MAX_CALLS_PER_TOOL=8
RUN_MAX_DURATION_MS=180000

# --- Tools -------------------------------------------------------------------
TOOLS_BUILTIN_ENABLED=true
# Fixed instant for the time tool (ISO-8601), e.g. 2026-09-17T10:00:00Z. Empty = wall clock.
TOOLS_FIXED_TIME=
# Example MCP server against tools/mock-mcp-server.py on the host.
MCP_MOCK_ENABLED=false
MCP_MOCK_URL=http://host.docker.internal:3333/mcp

# --- Verification against mocks ----------------------------------------------
# Redirects EVERY model call, whatever the files say. Set it when checking the stack against
# tools/mock-openai-server.py so no real call can slip through. Leave empty in normal use.
#MODEL_BASE_URL_OVERRIDE=http://host.docker.internal:1234/v1
